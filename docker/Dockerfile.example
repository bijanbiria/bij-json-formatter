# --- Build Stage ---
FROM node:20-alpine as builder

WORKDIR /app

COPY . .

RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm install --frozen-lockfile
RUN pnpm build

# --- Runtime Stage ---
FROM node:20-alpine

WORKDIR /app

COPY --from=builder /app ./

RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm install --prod --frozen-lockfile

EXPOSE 3000

CMD ["pnpm", "start"]